---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { siteConfig } from '../data/business';
---

<BaseLayout
  title="Terms of Service — Inside Prosper | Prosper, TX Local Business Directory"
  description="Terms of Service for Inside Prosper, the local business directory for Prosper, Texas."
>
  <Navbar />
  <main class="bg-bg-alt pt-32 pb-20">
    <div class="mx-auto max-w-3xl px-6">
      <h1 class="font-heading text-4xl font-bold text-text">Terms of Service</h1>
      <p class="mt-2 text-sm text-text-muted">Last updated: March 25, 2026</p>

      <div class="mt-10 space-y-8 text-base leading-relaxed text-text-muted">
        <section>
          <h2 class="text-xl font-semibold text-text">Agreement to Terms</h2>
          <p class="mt-3">By accessing or using the {siteConfig.name} website at <a href={siteConfig.siteUrl} class="text-primary hover:underline">{siteConfig.siteUrl}</a>, you agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use the site.</p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-text">Use of the Site</h2>
          <p class="mt-3">{siteConfig.name} is a local business directory for Prosper, Texas and surrounding areas. The site is provided for informational purposes only. You agree to use it lawfully and in a manner that does not infringe on the rights of others.</p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-text">Business Listings</h2>
          <ul class="mt-3 list-disc space-y-2 pl-6">
            <li>All business listings on {siteConfig.name} are curated and published at our discretion.</li>
            <li>We make reasonable efforts to ensure listing information is accurate, but we do not guarantee the accuracy, completeness, or reliability of any business information displayed.</li>
            <li>Inclusion on {siteConfig.name} does not constitute an endorsement, recommendation, or guarantee of any listed business.</li>
            <li>Business owners may request updates or removal of their listing by contacting us.</li>
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-text">Intellectual Property</h2>
          <p class="mt-3">All content on this site — including text, graphics, logos, and design — is the property of {siteConfig.name} or its respective owners and is protected by applicable copyright and trademark laws. You may not reproduce, distribute, or create derivative works from this content without written permission.</p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-text">Disclaimer of Warranties</h2>
          <p class="mt-3">This site is provided "as is" without warranties of any kind, either express or implied. We do not warrant that the site will be uninterrupted, error-free, or free of viruses or other harmful components.</p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-text">Limitation of Liability</h2>
          <p class="mt-3">{siteConfig.name} and its operators shall not be held liable for any damages arising from the use or inability to use this website, or from any information, products, or services obtained through the site.</p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-text">External Links</h2>
          <p class="mt-3">Our site may contain links to third-party websites. We are not responsible for the content or privacy practices of those external sites.</p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-text">Changes to These Terms</h2>
          <p class="mt-3">We reserve the right to modify these Terms of Service at any time. Changes will be posted on this page with an updated revision date. Continued use of the site after changes constitutes acceptance.</p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-text">Contact Us</h2>
          <p class="mt-3">For questions about these Terms of Service, contact us at:</p>
          <p class="mt-2">
            <a href={`mailto:${siteConfig.email}`} class="text-primary hover:underline">{siteConfig.email}</a><br />
            <a href={`tel:${siteConfig.phoneRaw}`} class="text-primary hover:underline">{siteConfig.phone}</a>
          </p>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
