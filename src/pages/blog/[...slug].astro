---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import ArticleSchema from '../../components/schema/ArticleSchema.astro';
import FAQSchema from '../../components/schema/FAQSchema.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../data/business';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const breadcrumbItems = [
  { name: 'Home', url: siteConfig.siteUrl },
  { name: 'Blog', url: `${siteConfig.siteUrl}/blog/` },
  { name: post.data.title, url: `${siteConfig.siteUrl}/blog/${post.id}/` },
];
---

<BaseLayout
  title={`${post.data.title} | ${siteConfig.name}`}
  description={post.data.description}
>
  <BreadcrumbSchema items={breadcrumbItems} />
  {post.data.faqs && <FAQSchema faqs={post.data.faqs} />}
  <ArticleSchema
    title={post.data.title}
    description={post.data.description}
    pubDate={post.data.pubDate}
    author={post.data.author}
    url={`${siteConfig.siteUrl}/blog/${post.id}/`}
    image={post.data.image ? `${siteConfig.siteUrl}${post.data.image}` : undefined}
  />
  <Navbar />
  <main>
    <!-- Hero -->
    <section class="bg-bg-dark pt-32 pb-16 lg:pt-40 lg:pb-20">
      <div class="mx-auto max-w-3xl px-6">
        <nav class="mb-8 flex items-center gap-2 text-sm text-white/40" aria-label="Breadcrumb">
          <a href="/" class="transition-colors hover:text-primary">Home</a>
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          <a href="/blog/" class="transition-colors hover:text-primary">Blog</a>
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          <span class="text-white/70 truncate max-w-xs">{post.data.title}</span>
        </nav>

        <div class="flex flex-wrap items-center gap-3 mb-6">
          {post.data.tags.map((tag: string) => (
            <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-primary backdrop-blur-sm border border-white/10">
              {tag}
            </span>
          ))}
        </div>

        <h1 class="font-heading text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl">
          {post.data.title}
        </h1>

        <div class="mt-6 flex items-center gap-4 text-sm text-white/50">
          <span>By {post.data.author}</span>
          <span class="text-white/20">·</span>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
      </div>
    </section>

    <!-- Article content -->
    <section class="bg-bg py-16 lg:py-24">
      <div class="mx-auto max-w-3xl px-6">
        <article class="prose prose-lg max-w-none text-text-muted prose-headings:font-heading prose-headings:text-text prose-a:text-primary prose-strong:text-text">
          <Content />
        </article>

        <!-- Back to blog -->
        <div class="mt-16 border-t border-border pt-8">
          <a href="/blog/" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-primary-dark transition-colors">
            <svg class="size-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            Back to all posts
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
