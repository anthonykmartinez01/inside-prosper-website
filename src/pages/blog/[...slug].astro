---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import ArticleSchema from '../../components/schema/ArticleSchema.astro';
import FAQSchema from '../../components/schema/FAQSchema.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../data/business';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const breadcrumbItems = [
  { name: 'Home', url: siteConfig.siteUrl },
  { name: 'Blog', url: `${siteConfig.siteUrl}/blog/` },
  { name: post.data.title, url: `${siteConfig.siteUrl}/blog/${post.id}/` },
];

const faqs = post.data.faqs || [];
---

<BaseLayout
  title={`${post.data.title} | ${siteConfig.name}`}
  description={post.data.description}
>
  <BreadcrumbSchema items={breadcrumbItems} />
  {faqs.length > 0 && <FAQSchema faqs={faqs} />}
  <ArticleSchema
    title={post.data.title}
    description={post.data.description}
    pubDate={post.data.pubDate}
    author={post.data.author}
    url={`${siteConfig.siteUrl}/blog/${post.id}/`}
    image={post.data.image ? `${siteConfig.siteUrl}${post.data.image}` : undefined}
  />
  <Navbar />
  <main>
    <!-- Hero -->
    <section class="bg-bg-dark pt-32 pb-16 lg:pt-40 lg:pb-20">
      <div class="mx-auto max-w-3xl px-6">
        <nav class="mb-8 flex items-center gap-2 text-sm text-white/40" aria-label="Breadcrumb">
          <a href="/" class="transition-colors hover:text-primary">Home</a>
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          <a href="/blog/" class="transition-colors hover:text-primary">Blog</a>
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          <span class="text-white/70 truncate max-w-xs">{post.data.title}</span>
        </nav>

        <div class="flex flex-wrap items-center gap-3 mb-6">
          {post.data.tags.map((tag: string) => (
            <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-primary backdrop-blur-sm border border-white/10">
              {tag}
            </span>
          ))}
        </div>

        <h1 class="font-heading text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl">
          {post.data.title}
        </h1>

        <div class="mt-6 flex items-center gap-4 text-sm text-white/50">
          <span>By {post.data.author}</span>
          <span class="text-white/20">&middot;</span>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
      </div>
    </section>

    <!-- Article content -->
    <section class="bg-bg py-16 lg:py-24">
      <div class="mx-auto max-w-3xl px-6">
        <article class="prose prose-lg max-w-none text-text-muted prose-headings:font-heading prose-headings:text-text prose-a:text-primary prose-strong:text-text">
          <Content />
        </article>

        <!-- FAQ Accordion -->
        {faqs.length > 0 && (
          <div style="margin-top:4rem;">
            <h2 class="font-heading text-2xl font-extrabold tracking-tight text-text sm:text-3xl" style="margin-bottom:1.5rem;">
              Frequently Asked Questions
            </h2>
            <div id="faq-accordion">
              {faqs.map((faq: { question: string; answer: string }, i: number) => (
                <div class="faq-item" style="border:1px solid #e5e7eb;border-radius:12px;margin-bottom:0.75rem;overflow:hidden;background:#ffffff;">
                  <button
                    type="button"
                    class="faq-question"
                    aria-expanded="false"
                    aria-controls={`faq-answer-${i}`}
                    style="width:100%;display:flex;justify-content:space-between;align-items:center;padding:1rem 1.25rem;background:transparent;border:none;cursor:pointer;text-align:left;color:#1a1a1a;font-size:1.05rem;font-weight:600;font-family:inherit;min-height:48px;"
                  >
                    <span>{faq.question}</span>
                    <svg class="faq-chevron" style="width:20px;height:20px;flex-shrink:0;margin-left:1rem;transition:transform 0.3s ease;stroke:#F28C38;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </button>
                  <div
                    id={`faq-answer-${i}`}
                    class="faq-answer"
                    role="region"
                    style="max-height:0;overflow:hidden;transition:max-height 0.3s ease;padding:0 1.25rem;"
                  >
                    <p style="padding-bottom:1rem;color:#6b7280;line-height:1.7;font-size:0.95rem;">
                      {faq.answer}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Back to blog -->
        <div class="mt-16 border-t border-border pt-8">
          <a href="/blog/" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-primary-dark transition-colors">
            <svg class="size-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            Back to all posts
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  // FAQ Accordion — lightweight, no external dependencies
  function initFaqAccordion() {
    var accordion = document.getElementById('faq-accordion');
    if (!accordion) return;

    var buttons = accordion.querySelectorAll('.faq-question');
    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var item = btn.parentElement;
        var answer = item.querySelector('.faq-answer');
        var chevron = btn.querySelector('.faq-chevron');
        var isOpen = btn.getAttribute('aria-expanded') === 'true';

        // Close all other items
        var allItems = accordion.querySelectorAll('.faq-item');
        allItems.forEach(function(other) {
          if (other === item) return;
          var otherBtn = other.querySelector('.faq-question');
          var otherAnswer = other.querySelector('.faq-answer');
          var otherChevron = other.querySelector('.faq-chevron');
          if (otherBtn && otherAnswer && otherChevron) {
            otherBtn.setAttribute('aria-expanded', 'false');
            otherAnswer.style.maxHeight = '0';
            otherChevron.style.transform = 'rotate(0deg)';
          }
        });

        // Toggle current item
        if (isOpen) {
          btn.setAttribute('aria-expanded', 'false');
          answer.style.maxHeight = '0';
          chevron.style.transform = 'rotate(0deg)';
        } else {
          btn.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + 'px';
          chevron.style.transform = 'rotate(180deg)';
        }
      });
    });
  }
  document.addEventListener('DOMContentLoaded', initFaqAccordion);
  if (document.readyState !== 'loading') initFaqAccordion();
</script>
