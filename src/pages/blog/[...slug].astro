---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import ArticleSchema from '../../components/schema/ArticleSchema.astro';
import FAQSchema from '../../components/schema/FAQSchema.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../data/business';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const breadcrumbItems = [
  { name: 'Home', url: siteConfig.siteUrl },
  { name: 'Blog', url: `${siteConfig.siteUrl}/blog/` },
  { name: post.data.title, url: `${siteConfig.siteUrl}/blog/${post.id}/` },
];

const faqs = post.data.faqs || [];
---

<BaseLayout
  title={`${post.data.title} | ${siteConfig.name}`}
  description={post.data.description}
>
  <BreadcrumbSchema items={breadcrumbItems} />
  {faqs.length > 0 && <FAQSchema faqs={faqs} />}
  <ArticleSchema
    title={post.data.title}
    description={post.data.description}
    pubDate={post.data.pubDate}
    author={post.data.author}
    url={`${siteConfig.siteUrl}/blog/${post.id}/`}
    image={post.data.image ? `${siteConfig.siteUrl}${post.data.image}` : undefined}
  />
  <Navbar />
  <main>
    <!-- Hero -->
    <section class="bg-bg-dark pt-32 pb-16 lg:pt-40 lg:pb-20">
      <div class="mx-auto max-w-3xl px-6">
        <nav class="mb-8 flex items-center gap-2 text-sm text-white/40" aria-label="Breadcrumb">
          <a href="/" class="transition-colors hover:text-primary">Home</a>
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          <a href="/blog/" class="transition-colors hover:text-primary">Blog</a>
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          <span class="text-white/70 truncate max-w-xs">{post.data.title}</span>
        </nav>

        <div class="flex flex-wrap items-center gap-3 mb-6">
          {post.data.tags.map((tag: string) => (
            <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-primary backdrop-blur-sm border border-white/10">
              {tag}
            </span>
          ))}
        </div>

        <h1 class="font-heading text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl">
          {post.data.title}
        </h1>

        <div class="mt-6 flex items-center gap-4 text-sm text-white/50">
          <span>By {post.data.author}</span>
          <span class="text-white/20">&middot;</span>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
      </div>
    </section>

    <!-- Article content -->
    <section class="bg-bg py-16 lg:py-24">
      <div class="mx-auto max-w-3xl px-6">
        <article class="prose prose-lg max-w-none text-text-muted prose-headings:font-heading prose-headings:text-text prose-a:text-primary prose-strong:text-text">
          <Content />
        </article>

        <!-- FAQ Accordion -->
        {faqs.length > 0 && (
          <div class="mt-16">
            <h2 class="font-heading text-2xl font-extrabold tracking-tight text-text sm:text-3xl mb-6">
              Frequently Asked Questions
            </h2>
            <div class="space-y-3" id="faq-accordion">
              {faqs.map((faq: { question: string; answer: string }, i: number) => (
                <div class="faq-item overflow-hidden rounded-xl border border-border bg-bg-card transition-colors">
                  <button
                    type="button"
                    class="faq-trigger flex w-full cursor-pointer items-center justify-between gap-4 px-6 py-5 text-left text-base font-semibold text-text transition-colors hover:text-primary"
                    aria-expanded="false"
                    aria-controls={`faq-answer-${i}`}
                    data-faq-index={i}
                  >
                    <span>{faq.question}</span>
                    <svg class="faq-chevron size-5 shrink-0 text-text-muted transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                  <div
                    id={`faq-answer-${i}`}
                    class="faq-answer"
                    role="region"
                    aria-labelledby={`faq-q-${i}`}
                    style="display:grid;grid-template-rows:0fr;transition:grid-template-rows 300ms ease;"
                  >
                    <div class="overflow-hidden">
                      <p class="px-6 pb-5 text-sm leading-relaxed text-text-muted">
                        {faq.answer}
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Back to blog -->
        <div class="mt-16 border-t border-border pt-8">
          <a href="/blog/" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-primary-dark transition-colors">
            <svg class="size-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            Back to all posts
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // FAQ Accordion — lightweight, no external dependencies
  document.addEventListener('astro:page-load', () => {
    const accordion = document.getElementById('faq-accordion');
    if (!accordion) return;

    accordion.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest('.faq-trigger') as HTMLButtonElement | null;
      if (!trigger) return;

      const item = trigger.closest('.faq-item');
      if (!item) return;

      const answer = item.querySelector('.faq-answer') as HTMLElement;
      const chevron = item.querySelector('.faq-chevron') as HTMLElement;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      // Close all other items
      accordion.querySelectorAll('.faq-item').forEach((other) => {
        if (other === item) return;
        const otherTrigger = other.querySelector('.faq-trigger') as HTMLButtonElement;
        const otherAnswer = other.querySelector('.faq-answer') as HTMLElement;
        const otherChevron = other.querySelector('.faq-chevron') as HTMLElement;
        if (otherTrigger && otherAnswer && otherChevron) {
          otherTrigger.setAttribute('aria-expanded', 'false');
          otherAnswer.style.gridTemplateRows = '0fr';
          otherChevron.style.transform = 'rotate(0deg)';
        }
      });

      // Toggle current item
      if (isOpen) {
        trigger.setAttribute('aria-expanded', 'false');
        answer.style.gridTemplateRows = '0fr';
        chevron.style.transform = 'rotate(0deg)';
      } else {
        trigger.setAttribute('aria-expanded', 'true');
        answer.style.gridTemplateRows = '1fr';
        chevron.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
