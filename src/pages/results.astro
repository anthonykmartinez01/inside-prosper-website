---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { siteConfig } from '../data/business';

const breadcrumbItems = [
  { name: 'Home', url: siteConfig.siteUrl },
  { name: 'Results', url: `${siteConfig.siteUrl}/results/` },
];
---

<BaseLayout
  title="Client Results — Inside Prosper Local SEO and Marketing"
  description="Real results from real local businesses in Prosper, TX. See how Inside Prosper helps businesses dominate Google Maps, rank higher, and get more customers."
  noindex={true}
>
  <BreadcrumbSchema items={breadcrumbItems} />
  <Navbar />
  <main>
    <!-- Hero -->
    <section class="bg-bg-dark pt-32 pb-20 lg:pt-40 lg:pb-28">
      <div class="mx-auto max-w-7xl px-6">
        <nav class="mb-8 flex items-center gap-2 text-sm text-white/40" aria-label="Breadcrumb">
          <a href="/" class="transition-colors hover:text-primary">Home</a>
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          <span class="text-white/70">Results</span>
        </nav>

        <span class="mb-4 inline-block text-sm font-semibold uppercase tracking-wider text-primary">
          Proven Results
        </span>
        <h1 class="font-heading text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
          Real Results for <span class="font-display italic text-primary">Real Businesses</span>
        </h1>
        <p class="mt-4 max-w-2xl text-base text-white/60 sm:text-lg">
          We help local businesses in Prosper, TX show up where it matters most — Google Maps, local search, and right in front of their customers.
        </p>
      </div>
    </section>

    <!-- Intro -->
    <section class="bg-bg py-16 lg:py-24">
      <div class="mx-auto max-w-3xl px-6">
        <h2 class="font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl">
          What We Do for Local Businesses
        </h2>
        <div class="mt-8 space-y-5 text-base leading-relaxed text-text-muted">
          <p>
            Inside Prosper is more than a local business directory. We work directly with business owners in Prosper and the surrounding North Texas area to improve their visibility on Google, drive more calls and foot traffic, and build the kind of online presence that turns searches into customers.
          </p>
          <p>
            The results below are from real clients — local businesses who trusted us with their Google Business Profile optimization, local SEO, and digital marketing. No stock photos, no hypothetical numbers. Just real rank tracking data from real campaigns.
          </p>
        </div>
      </div>
    </section>

    <!-- Case Studies -->
    <section class="bg-bg-alt py-16 lg:py-24">
      <div class="mx-auto max-w-5xl px-6">
        <div class="mb-16 text-center">
          <span class="mb-4 inline-block text-sm font-semibold uppercase tracking-wider text-primary">
            Case Studies
          </span>
          <h2 class="font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl">
            Google Maps <span class="font-display italic text-primary">Domination</span>
          </h2>
          <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-text-muted">
            Ranking in the Google Maps 3-pack is where local businesses win or lose. Here is how we have helped our clients own their local market.
          </p>
        </div>

        <!-- Result Card 1 -->
        <div class="overflow-hidden rounded-2xl bg-bg shadow-lg border border-border">
          <div class="p-8 lg:p-10">
            <div class="mb-6 flex flex-wrap items-center gap-3">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-green-50 px-3 py-1 text-sm font-semibold text-green-700">
                <svg class="size-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.403 12.652a3 3 0 010-5.304 3 3 0 00-3.75-3.751 3 3 0 00-5.305 0 3 3 0 00-3.751 3.75 3 3 0 000 5.305 3 3 0 003.75 3.751 3 3 0 005.305 0 3 3 0 003.751-3.75zm-2.546-4.46a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
                Verified Result
              </span>
              <span class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-sm font-medium text-primary">
                Google Maps
              </span>
            </div>
            <h3 class="font-heading text-2xl font-extrabold tracking-tight text-text sm:text-3xl">
              Local Business Google Maps Rank Tracking
            </h3>
            <p class="mt-3 text-base leading-relaxed text-text-muted">
              This rank map shows how one of our clients is performing across their entire local service area in Google Maps. Green means they are ranking in the top 3 positions — the coveted map pack that drives the majority of calls and clicks for local searches.
            </p>

            <!-- Stats Row -->
            <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
              <div class="rounded-xl bg-bg-alt p-4 text-center">
                <p class="font-heading text-2xl font-extrabold text-green-600">Top 3</p>
                <p class="mt-1 text-sm text-text-muted">Map Pack Ranking</p>
              </div>
              <div class="rounded-xl bg-bg-alt p-4 text-center">
                <p class="font-heading text-2xl font-extrabold text-primary">Local SEO</p>
                <p class="mt-1 text-sm text-text-muted">Service Type</p>
              </div>
              <div class="rounded-xl bg-bg-alt p-4 text-center">
                <p class="font-heading text-2xl font-extrabold text-text">Prosper, TX</p>
                <p class="mt-1 text-sm text-text-muted">Market Area</p>
              </div>
              <div class="rounded-xl bg-bg-alt p-4 text-center">
                <p class="font-heading text-2xl font-extrabold text-green-600">Active</p>
                <p class="mt-1 text-sm text-text-muted">Campaign Status</p>
              </div>
            </div>

            <!-- Rank Map -->
            <div class="mt-8 overflow-hidden rounded-xl border border-border">
              <object
                data="/images/results-rankmap.pdf"
                type="application/pdf"
                width="100%"
                height="700"
                class="w-full min-h-[400px] sm:min-h-[500px] lg:min-h-[700px]"
              >
                <div class="flex flex-col items-center justify-center gap-4 p-8 text-center">
                  <p class="text-text-muted">Your browser does not support embedded PDFs.</p>
                  <a
                    href="/images/results-rankmap.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-2.5 text-sm font-semibold text-white transition-all hover:bg-primary-dark"
                  >
                    View Rank Map
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                  </a>
                </div>
              </object>
            </div>

            <p class="mt-6 text-sm text-text-muted italic">
              Rank map data is from an active client campaign. Green markers indicate top 3 Google Maps positions. Results vary by business, location, and competition.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-bg py-16 lg:py-24">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <h2 class="font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl">
          Want Results Like <span class="font-display italic text-primary">These?</span>
        </h2>
        <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-text-muted">
          If you are a local business in Prosper or the surrounding North Texas area and want to show up where your customers are searching, let's talk.
        </p>
        <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a
            href="/get-listed/"
            class="inline-flex items-center gap-2 rounded-full bg-primary px-8 py-3.5 text-base font-semibold text-white shadow-md transition-all duration-200 hover:bg-primary-dark hover:shadow-lg"
          >
            Get Started
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
          <a
            href="tel:+14694811395"
            class="inline-flex items-center gap-2 rounded-full border-2 border-text/10 px-8 py-3.5 text-base font-semibold text-text transition-all duration-200 hover:border-primary hover:text-primary"
          >
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            Call (469) 481-1395
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
