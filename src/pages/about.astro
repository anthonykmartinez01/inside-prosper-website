---
import { Image } from 'astro:assets';
import BaseLayout from '../components/layout/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { siteConfig } from '../data/business';
import anthonyImage from '../assets/images/anthony-martinez.webp';

const breadcrumbItems = [
  { name: 'Home', url: siteConfig.siteUrl },
  { name: 'About', url: `${siteConfig.siteUrl}/about/` },
];
---

<BaseLayout
  title="About Inside Prosper — Prosper's Local Business Directory"
  description="Inside Prosper is a curated, invitation-only directory connecting Prosper, Texas residents with trusted local businesses. Learn about our mission."
>
  <BreadcrumbSchema items={breadcrumbItems} />
  <Navbar />
  <main>
    <!-- Hero -->
    <section class="bg-bg-dark pt-32 pb-20 lg:pt-40 lg:pb-28">
      <div class="mx-auto max-w-7xl px-6">
        <nav class="mb-8 flex items-center gap-2 text-sm text-white/40" aria-label="Breadcrumb">
          <a href="/" class="transition-colors hover:text-primary">Home</a>
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          <span class="text-white/70">About</span>
        </nav>

        <span class="mb-4 inline-block text-sm font-semibold uppercase tracking-wider text-primary">
          Our Story
        </span>
        <h1 class="font-heading text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
          About <span class="font-display italic text-primary">Inside Prosper</span>
        </h1>
        <p class="mt-4 max-w-2xl text-base text-white/60 sm:text-lg">
          A curated directory for the people who live, work, and support local in Prosper, Texas.
        </p>
      </div>
    </section>

    <!-- Mission -->
    <section class="bg-bg py-16 lg:py-24">
      <div class="mx-auto max-w-3xl px-6">
        <h2 class="font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl">
          Why We Built This
        </h2>
        <div class="mt-8 space-y-5 text-base leading-relaxed text-text-muted">
          <p>
            The best local businesses are not always the ones with the biggest ad budgets. They are the ones your neighbor tells you about at the soccer field, the ones that sponsor your kid's little league team, the ones run by families who live right here in Prosper.
          </p>
          <p>
            <strong class="text-text">Inside Prosper</strong> was created to give those businesses a platform. Our directory is free and invitation-only, which means you are not seeing who paid the most to be here. You are seeing business owners who earned their spot because they take pride in their work and stand behind it.
          </p>
          <p>
            We believe that knowing the people behind a business matters. When you hire a plumber who coaches at your gym, or eat at a restaurant where the owner greets you by name, there is an accountability and a warmth that you just cannot get from a faceless chain.
          </p>
        </div>
      </div>
    </section>

    <!-- What makes us different -->
    <section class="bg-bg-white py-16 lg:py-24">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl text-center mb-12">
          What Makes Us Different
        </h2>
        <div class="grid gap-8 sm:grid-cols-3">
          <div class="rounded-2xl border border-border bg-bg-card p-8">
            <div class="flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary mb-5">
              <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            </div>
            <h3 class="font-heading text-lg font-bold text-text">Invitation-Only</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">
              Every business on Inside Prosper is here because they earned it — not because they paid for a listing.
            </p>
          </div>
          <div class="rounded-2xl border border-border bg-bg-card p-8">
            <div class="flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary mb-5">
              <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <h3 class="font-heading text-lg font-bold text-text">Community-Driven</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">
              We feature businesses that your neighbors actually use and recommend — real trust, not paid reviews.
            </p>
          </div>
          <div class="rounded-2xl border border-border bg-bg-card p-8">
            <div class="flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary mb-5">
              <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" /></svg>
            </div>
            <h3 class="font-heading text-lg font-bold text-text">Giveaways & Events</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">
              We run giveaways, raffles, and scavenger hunts to make discovering local businesses fun for the whole family.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Founder -->
    <section class="bg-bg py-16 lg:py-24">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid gap-12 lg:grid-cols-5 lg:gap-20 items-center">
          <div class="lg:col-span-3">
            <h2 class="font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl">
              Meet the Founder
            </h2>
            <div class="mt-6 space-y-4 text-base leading-relaxed text-text-muted">
              <p>
                I'm Anthony Martinez, the Content Director for Inside Prosper. I created this platform because I saw a gap between the amazing businesses in our community and the people who need to find them.
              </p>
              <p>
                Too often, the best local spots get buried under big-budget advertising from chains that do not know our community. Inside Prosper changes that by putting real, trusted businesses front and center — the ones your neighbors actually vouch for.
              </p>
            </div>
          </div>
          <div class="lg:col-span-2 flex justify-center">
            <div class="overflow-hidden rounded-2xl shadow-lg" style="max-height: 480px;">
              <Image
                src={anthonyImage}
                alt="Anthony Martinez, Content Director for Inside Prosper"
                width={400}
                height={540}
                loading="lazy"
                format="webp"
                quality={70}
                class="h-auto w-full max-w-sm object-cover object-top"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-bg-dark py-20 text-center">
      <div class="mx-auto max-w-2xl px-6">
        <h2 class="font-heading text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Ready to Support <span class="text-primary">Local</span>?
        </h2>
        <p class="mt-4 text-base text-white/60">
          Browse our directory and discover the businesses that make Prosper special.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a
            href="/"
            class="inline-flex items-center gap-3 rounded-full bg-primary px-8 py-3.5 font-semibold text-white transition-all duration-200 hover:bg-primary-dark"
          >
            Explore Businesses
          </a>
          <a
            href="/get-listed/"
            class="inline-flex items-center gap-3 rounded-full border border-white/25 px-8 py-3.5 font-semibold text-white transition-all duration-200 hover:bg-white/10"
          >
            Get Listed
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
