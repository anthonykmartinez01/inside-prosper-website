---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import BusinessCard from '../../components/ui/BusinessCard.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import BusinessSchema from '../../components/schema/BusinessSchema.astro';
import { publishedBusinesses, categories, getBusinessesByCategory, getCategoryBySlug, getCategoryUrl, getBusinessUrl, siteConfig, type Business, type Category } from '../../data/business';

const localImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{png,jpg,jpeg,webp}', { eager: true });

export function getStaticPaths() {
  return publishedBusinesses.map((biz) => {
    const cat = getCategoryBySlug(biz.category);
    return {
      params: { category: cat?.urlPath || biz.category, slug: biz.slug },
      props: { business: biz },
    };
  });
}

interface Props {
  business: Business;
}

const { business } = Astro.props;
const category = getCategoryBySlug(business.category);
// Sort verified businesses first, preserving original order within each group
const relatedBusinesses = getBusinessesByCategory(business.category)
  .filter((b) => b.slug !== business.slug)
  .sort((a, b) => Number(Boolean(b.verified)) - Number(Boolean(a.verified)));

// Resolve local image for optimization
const isLocalImage = business.image.startsWith('/images/');
const imageFilename = isLocalImage ? business.image.replace('/images/', '') : '';
const resolvedImage = isLocalImage ? localImages[`/src/assets/images/${imageFilename}`]?.default : null;

// Hero image aspect handling: honor imageAspect from data, default to 16/10 landscape.
// Anything narrower than ~1.4:1 (portrait OR near-square) gets a constrained
// max-width so it doesn't dominate the column and force endless scrolling.
const heroAspect = business.imageAspect || '16/10';
const [aspectW, aspectH] = heroAspect.split('/').map(Number);
const aspectRatio = aspectW && aspectH ? aspectW / aspectH : 1.6;
const isPortrait = aspectRatio < 1; // strict portrait
const isNarrow = aspectRatio < 1.4; // portrait OR near-square
const heroAspectStyle = `aspect-ratio: ${heroAspect};`;
const heroWrapperClass = isNarrow
  ? 'mx-auto max-w-md overflow-hidden rounded-2xl shadow-md'
  : 'overflow-hidden rounded-2xl';
// Tailwind safelist: aspect-[16/10] aspect-[3/4] aspect-[4/5]

const breadcrumbItems = [
  { name: 'Home', url: siteConfig.siteUrl },
  ...(category ? [{ name: category.name, url: `${siteConfig.siteUrl}${getCategoryUrl(category)}` }] : []),
  { name: business.name, url: `${siteConfig.siteUrl}${getBusinessUrl(business)}` },
];
---

<BaseLayout
  title={`${business.name}, ${category?.name || 'Business'} in Prosper, TX | ${siteConfig.name}`}
  description={business.shortDescription}
  ogImage={business.image || undefined}
>
  <BreadcrumbSchema items={breadcrumbItems} />
  <BusinessSchema business={business} />
  <Navbar />
  <main>
    <!-- Hero -->
    <section class="bg-bg-dark pt-32 pb-16 lg:pt-40 lg:pb-20">
      <div class="mx-auto max-w-7xl px-6">
        <!-- Breadcrumb -->
        <nav class="mb-8 flex items-center gap-2 text-sm text-white/40" aria-label="Breadcrumb">
          <a href="/" class="transition-colors hover:text-primary">Home</a>
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          {category && (
            <>
              <a href={getCategoryUrl(category)} class="transition-colors hover:text-primary">{category.name}</a>
              <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </>
          )}
          <span class="text-white/70">{business.name}</span>
        </nav>

        <div class="mb-4 flex flex-wrap items-center gap-3">
          {category && (
            <a href={getCategoryUrl(category)} class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-primary backdrop-blur-sm border border-white/10 transition-colors hover:bg-white/15">
              {category.name}
            </a>
          )}
          {business.verified && (
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/15 px-4 py-1.5 text-sm font-semibold text-emerald-400 border border-emerald-500/20">
              <svg class="size-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.403 12.652a3 3 0 010-5.304 3 3 0 00-3.75-3.751 3 3 0 00-5.305 0 3 3 0 00-3.751 3.75 3 3 0 000 5.305 3 3 0 003.75 3.751 3 3 0 005.305 0 3 3 0 003.751-3.75zm-2.546-4.46a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
              Verified Business
            </span>
          )}
        </div>
        <h1 class="font-heading text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
          {business.name}<span class="text-white/40">,</span> <span class="font-display italic text-primary">{business.locationLabel || 'Prosper, TX'}</span>
        </h1>
        <p class="mt-4 max-w-2xl text-base text-white/60 sm:text-lg">
          {business.shortDescription}
        </p>

        {/* Mobile-only quick actions, the sticky contact sidebar is below the
            article on small screens, so surface call/website in the hero.
            Hidden on lg+ where the sidebar is visible alongside the content. */}
        {business.phone && (
          <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:hidden">
            <a
              href={`tel:${business.phone.replace(/[^\d+]/g, '')}`}
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-primary-dark"
            >
              <svg class="size-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 006.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 011.767-1.052l3.223.716A1.5 1.5 0 0118 15.352V16.5a1.5 1.5 0 01-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 012.43 8.326 13.019 13.019 0 012 5V3.5z" /></svg>
              Call {business.phone}
            </a>
            {business.website && (
              <a
                href={business.website}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/20 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-white/10"
              >
                Visit Website
              </a>
            )}
          </div>
        )}
      </div>
    </section>

    <!-- Business content -->
    <section class="bg-bg py-16 lg:py-24">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid gap-12 lg:grid-cols-3">
          <!-- Main content -->
          <div class="lg:col-span-2">
            <!-- Image -->
            {isNarrow ? (
              <figure class="my-0 mx-auto max-w-md">
                {resolvedImage ? (
                  <Image
                    src={resolvedImage}
                    alt={`${business.name}, local business in Prosper, Texas`}
                    width={1600}
                    height={Math.round(1600 * (aspectH / aspectW))}
                    loading="eager"
                    format="webp"
                    quality={85}
                    class="w-full max-h-[300px] sm:max-h-[500px] object-cover rounded-2xl shadow-md"
                    style={business.imagePosition ? `object-position: ${business.imagePosition}` : ''}
                  />
                ) : (
                  <img
                    src={business.image}
                    alt={`${business.name}, local business in Prosper, Texas`}
                    width="1600"
                    height={Math.round(1600 * (aspectH / aspectW))}
                    loading="eager"
                    class="w-full max-h-[300px] sm:max-h-[500px] object-cover rounded-2xl shadow-md"
                    style={business.imagePosition ? `object-position: ${business.imagePosition}` : ''}
                  />
                )}
              </figure>
            ) : (
              <div class="overflow-hidden rounded-2xl">
                {resolvedImage ? (
                  <Image
                    src={resolvedImage}
                    alt={`${business.name}, local business in Prosper, Texas`}
                    width={1600}
                    height={Math.round(1600 * (aspectH / aspectW))}
                    loading="eager"
                    format="webp"
                    quality={85}
                    class="w-full object-cover"
                    style={`${heroAspectStyle}${business.imagePosition ? ` object-position: ${business.imagePosition};` : ''}`}
                  />
                ) : (
                  <img
                    src={business.image}
                    alt={`${business.name}, local business in Prosper, Texas`}
                    width="800"
                    height={500}
                    loading="eager"
                    class="w-full object-cover"
                    style={`${heroAspectStyle}${business.imagePosition ? ` object-position: ${business.imagePosition};` : ''}`}
                  />
                )}
              </div>
            )}

            <!-- Description -->
            <div class="mt-10">
              {business.htmlDescription ? (
                <div class="prose prose-lg max-w-none text-text-muted [&>h2]:font-heading [&>h2]:text-2xl [&>h2]:font-extrabold [&>h2]:tracking-tight [&>h2]:text-text [&>h2]:mt-10 [&>h2]:mb-4 [&>h2:first-child]:mt-0 [&>p]:mt-4 [&>p]:text-base [&>p]:leading-relaxed [&>blockquote]:mt-8 [&>blockquote]:mb-8 [&>blockquote]:border-l-4 [&>blockquote]:border-primary [&>blockquote]:pl-6 [&>blockquote]:py-2 [&>blockquote]:text-lg [&>blockquote]:font-display [&>blockquote]:italic [&>blockquote]:text-text [&>iframe]:mt-6 [&>iframe]:mb-6 [&>iframe]:w-full [&>iframe]:rounded-xl [&>ul]:mt-6 [&>ul]:mb-6 [&>ul]:space-y-3 [&>ul]:pl-0 [&>ul]:list-none [&_li]:flex [&_li]:items-start [&_li]:gap-2 [&_li]:text-base [&_li]:leading-relaxed [&_li]:before:content-['✓'] [&_li]:before:text-primary [&_li]:before:font-bold" set:html={business.htmlDescription} />
              ) : (
                <>
                  <h2 class="font-heading text-2xl font-extrabold tracking-tight text-text sm:text-3xl">
                    About {business.name} in Prosper, Texas
                  </h2>
                  <p class="mt-4 text-base leading-relaxed text-text-muted">
                    {business.longDescription}
                  </p>
                </>
              )}
            </div>

            <!-- Featured in blog post -->
            {business.slug === '1418-coffee' && (
              <p class="mt-6 text-sm text-text-muted">
                Featured in our guide to the <a href="/blog/best-restaurants-in-prosper-tx/" class="font-semibold text-primary hover:text-primary-dark transition-colors">best restaurants in Prosper TX</a>.
              </p>
            )}

            <!-- Quote -->
            {business.quote && !business.htmlDescription && (
              <blockquote class="mt-10 border-l-4 border-primary pl-6 py-2">
                <p class="text-lg font-display italic text-text">
                  &ldquo;{business.quote}&rdquo;
                </p>
              </blockquote>
            )}
          </div>

          <!-- Sidebar -->
          <aside class="lg:col-span-1">
            <div class="sticky top-28 space-y-6">
              {business.logo && (
                <div class="flex items-center justify-center rounded-2xl border border-border bg-bg-card p-6 shadow-sm">
                  <img
                    src={business.logo}
                    alt={`${business.name} logo`}
                    loading="lazy"
                    class="h-auto w-full max-w-[220px] object-contain"
                  />
                </div>
              )}
              <div class="rounded-2xl border border-border bg-bg-card p-6 shadow-sm">
              <h3 class="font-heading text-lg font-bold text-text">Business Info</h3>

              <div class="mt-6 space-y-5">
                {business.phone && (
                  <div class="flex items-start gap-3">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                      <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                    </div>
                    <div>
                      <p class="text-sm font-medium text-text">Phone</p>
                      <a href={`tel:${business.phone.replace(/[^\d+]/g, '')}`} class="text-sm text-primary hover:text-primary-dark transition-colors">
                        {business.phone}
                      </a>
                    </div>
                  </div>
                )}

                {business.email && (
                  <div class="flex items-start gap-3">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                      <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                    </div>
                    <div>
                      <p class="text-sm font-medium text-text">Email</p>
                      <a href={`mailto:${business.email}`} class="text-sm text-primary hover:text-primary-dark transition-colors">
                        {business.email}
                      </a>
                    </div>
                  </div>
                )}

                {business.website && (
                  <div class="flex items-start gap-3">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                      <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
                    </div>
                    <div>
                      <p class="text-sm font-medium text-text">Website</p>
                      <a href={business.website} target="_blank" rel="noopener noreferrer" class="text-sm text-primary hover:text-primary-dark transition-colors">
                        {business.website.replace(/^https?:\/\//, '')}
                      </a>
                    </div>
                  </div>
                )}

                {business.address && (
                  <div class="flex items-start gap-3">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                      <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    </div>
                    <div>
                      <p class="text-sm font-medium text-text">Address</p>
                      <p class="text-sm text-text-muted">{business.address}</p>
                    </div>
                  </div>
                )}

                {business.hours && (
                  <div class="flex items-start gap-3">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                      <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </div>
                    <div>
                      <p class="text-sm font-medium text-text">Hours</p>
                      <p class="text-sm text-text-muted">{business.hours}</p>
                    </div>
                  </div>
                )}

                {(business.socials?.facebook || business.socials?.instagram || business.socials?.nextdoor || business.socials?.youtube) && (
                  <div class="flex items-start gap-3">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                      <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" /></svg>
                    </div>
                    <div>
                      <p class="text-sm font-medium text-text">Follow</p>
                      <div class="mt-1.5 flex items-center gap-2">
                        {business.socials?.facebook && (
                          <a
                            href={business.socials.facebook}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${business.name} on Facebook`}
                            class="group inline-flex size-9 items-center justify-center rounded-full border border-border bg-bg text-text-muted transition-all duration-200 hover:border-primary hover:bg-primary hover:text-white"
                          >
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
                              <path d="M13.5 21.5v-8.25h2.75l.41-3.19h-3.16V8.02c0-.92.26-1.55 1.58-1.55h1.69V3.62c-.29-.04-1.29-.12-2.46-.12-2.43 0-4.1 1.48-4.1 4.21v2.35H7.46v3.19h2.75V21.5h3.29z" />
                            </svg>
                          </a>
                        )}
                        {business.socials?.instagram && (
                          <a
                            href={business.socials.instagram}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${business.name} on Instagram`}
                            class="group inline-flex size-9 items-center justify-center rounded-full border border-border bg-bg text-text-muted transition-all duration-200 hover:border-primary hover:bg-primary hover:text-white"
                          >
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
                              <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 01-1.38-.9 3.7 3.7 0 01-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07zM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.86 5.86 0 00-2.13 1.38A5.86 5.86 0 00.63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.73 1.46 1.38 2.13a5.86 5.86 0 002.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.86 5.86 0 002.13-1.38 5.86 5.86 0 001.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.86 5.86 0 00-1.38-2.13A5.86 5.86 0 0019.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 100 12.32 6.16 6.16 0 000-12.32zm0 10.16a4 4 0 110-8 4 4 0 010 8zm6.41-10.4a1.44 1.44 0 11-2.88 0 1.44 1.44 0 012.88 0z"/>
                            </svg>
                          </a>
                        )}
                        {business.socials?.nextdoor && (
                          <a
                            href={business.socials.nextdoor}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${business.name} on Nextdoor`}
                            class="group inline-flex size-9 items-center justify-center rounded-full border border-border bg-bg text-text-muted transition-all duration-200 hover:border-primary hover:bg-primary hover:text-white"
                          >
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
                              <path d="M12 2.25c-2.45 0-4.6 1.27-5.84 3.18-.4-.39-1.13-1.05-1.84-1.05-1.16 0-2.07.91-2.07 2.06v3.41c0 .58.47 1.05 1.05 1.05.58 0 1.05-.47 1.05-1.05V6.44c0-.04.04-.04.07-.01.43.43 1.07 1.04 1.41 1.34-.45.97-.7 2.05-.7 3.19v9.78c0 .58.47 1.05 1.05 1.05h3.5c.58 0 1.05-.47 1.05-1.05v-5.92c0-.92.74-1.66 1.66-1.66h.71c.92 0 1.66.74 1.66 1.66v5.92c0 .58.47 1.05 1.05 1.05h3.5c.58 0 1.05-.47 1.05-1.05v-9.78c0-4.27-3.46-7.71-7.73-7.71z"/>
                            </svg>
                          </a>
                        )}
                        {business.socials?.youtube && (
                          <a
                            href={business.socials.youtube}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${business.name} on YouTube`}
                            class="group inline-flex size-9 items-center justify-center rounded-full border border-border bg-bg text-text-muted transition-all duration-200 hover:border-primary hover:bg-primary hover:text-white"
                          >
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
                              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                            </svg>
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                )}
              </div>

              {business.phone && (
                <a
                  href={`tel:${business.phone.replace(/[^\d+]/g, '')}`}
                  class="mt-8 flex w-full items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white transition-all duration-200 hover:bg-primary-dark"
                >
                  <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                  Call Now
                </a>
              )}
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Map -->
    {business.mapEmbedUrl && (
      <section class="bg-bg pb-16 lg:pb-24">
        <div class="mx-auto max-w-7xl px-6">
          <h2 class="font-heading text-2xl font-extrabold tracking-tight text-text sm:text-3xl mb-8">
            Find {business.name}
          </h2>
          <div class="overflow-hidden rounded-2xl border border-border shadow-sm">
            <iframe
              src={business.mapEmbedUrl}
              title={`Map showing ${business.name} location`}
              width="600"
              height="450"
              class="w-full aspect-[16/9] border-0"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>
      </section>
    )}

    <!-- Related businesses -->
    {relatedBusinesses.length > 0 && (
      <section class="bg-bg-white py-16 lg:py-24">
        <div class="mx-auto max-w-7xl px-6">
          <h2 class="font-heading text-2xl font-extrabold tracking-tight text-text sm:text-3xl mb-10">
            Other {category?.name} Businesses in Prosper
          </h2>
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {relatedBusinesses.map((biz) => (
              <BusinessCard
                name={biz.name}
                description={biz.shortDescription}
                image={biz.cardImage || biz.image}
                slug={biz.slug}
                category={category?.name}
                categoryUrlPath={category?.urlPath}
                imagePosition={biz.imagePosition}
                imageAspect={biz.cardImageAspect}
                verified={biz.verified}
              />
            ))}
          </div>
          {category && (
            <div class="mt-10 text-center">
              <a href={getCategoryUrl(category)} class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-primary-dark transition-colors">
                <svg class="size-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                Back to all {category.name}
              </a>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- CTA: Only show for unverified businesses -->
    {!business.verified && (
    <section class="bg-bg-dark py-20 text-center">
      <div class="mx-auto max-w-2xl px-6">
        <h2 class="font-heading text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Is This Your <span class="text-primary">Business</span>?
        </h2>
        <p class="mt-4 text-base text-white/60">
          Claim your listing to update your information, add photos, and connect with the Prosper community.
        </p>
        <a
          href="/list-your-business/"
          class="mt-8 inline-flex items-center gap-3 rounded-full bg-primary px-8 py-3.5 font-semibold text-white transition-all duration-200 hover:bg-primary-dark"
        >
          Get Listed
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </section>
    )}
  </main>
  <Footer />
</BaseLayout>
