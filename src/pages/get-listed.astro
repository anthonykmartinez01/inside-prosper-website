---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { siteConfig } from '../data/business';

const breadcrumbItems = [
  { name: 'Home', url: siteConfig.siteUrl },
  { name: 'Get Listed', url: `${siteConfig.siteUrl}/get-listed/` },
];
---

<BaseLayout
  title="List Your Business on Inside Prosper | Prosper, TX Directory"
  description="Get your Prosper, Texas business featured on Inside Prosper. Free, invitation-only listings that connect you with your neighbors."
>
  <BreadcrumbSchema items={breadcrumbItems} />
  <Navbar />
  <main>
    <!-- Hero -->
    <section class="bg-bg-dark pt-32 pb-20 lg:pt-40 lg:pb-28">
      <div class="mx-auto max-w-7xl px-6">
        <nav class="mb-8 flex items-center gap-2 text-sm text-white/40" aria-label="Breadcrumb">
          <a href="/" class="transition-colors hover:text-primary">Home</a>
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          <span class="text-white/70">Get Listed</span>
        </nav>

        <span class="mb-4 inline-block text-sm font-semibold uppercase tracking-wider text-primary">
          For Business Owners
        </span>
        <h1 class="font-heading text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
          Get Your Business on <span class="font-display italic text-primary">Inside Prosper</span>
        </h1>
        <p class="mt-4 max-w-2xl text-base text-white/60 sm:text-lg">
          Free, invitation-only listings that connect Prosper businesses with the neighbors who need them.
        </p>
      </div>
    </section>

    <!-- Benefits -->
    <section class="bg-bg py-16 lg:py-24">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl text-center mb-12">
          Why Get Listed?
        </h2>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <div class="rounded-2xl border border-border bg-bg-card p-8">
            <div class="flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary mb-5">
              <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
            </div>
            <h3 class="font-heading text-lg font-bold text-text">Local Visibility</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">
              Get discovered by Prosper residents actively searching for local businesses like yours. Your dedicated profile page ranks in Google for Prosper-specific searches.
            </p>
          </div>
          <div class="rounded-2xl border border-border bg-bg-card p-8">
            <div class="flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary mb-5">
              <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="font-heading text-lg font-bold text-text">Completely Free</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">
              There is no cost to be listed on Inside Prosper. We believe great businesses deserve exposure based on merit, not marketing budgets.
            </p>
          </div>
          <div class="rounded-2xl border border-border bg-bg-card p-8">
            <div class="flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary mb-5">
              <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            </div>
            <h3 class="font-heading text-lg font-bold text-text">Trusted Platform</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">
              Because listings are invitation-only, being featured on Inside Prosper is a signal of trust and quality to potential customers.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="bg-bg-white py-16 lg:py-24">
      <div class="mx-auto max-w-3xl px-6">
        <h2 class="font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl text-center mb-12">
          How It Works
        </h2>
        <div class="space-y-8">
          <div class="flex gap-5">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary text-white font-bold">1</div>
            <div>
              <h3 class="font-heading text-lg font-bold text-text">Reach Out</h3>
              <p class="mt-1 text-sm text-text-muted">Send us an email telling us about your business, what you do, and why you love serving the Prosper community.</p>
            </div>
          </div>
          <div class="flex gap-5">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary text-white font-bold">2</div>
            <div>
              <h3 class="font-heading text-lg font-bold text-text">We Review</h3>
              <p class="mt-1 text-sm text-text-muted">Our team reviews your submission to make sure it is a great fit for the Inside Prosper community.</p>
            </div>
          </div>
          <div class="flex gap-5">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary text-white font-bold">3</div>
            <div>
              <h3 class="font-heading text-lg font-bold text-text">Get Featured</h3>
              <p class="mt-1 text-sm text-text-muted">Once approved, we create your dedicated business profile with photos, description, contact info, and hours. You start getting discovered by neighbors immediately.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Application Form -->
    <section id="apply" class="bg-bg py-16 lg:py-24">
      <div class="mx-auto max-w-2xl px-6">
        <div class="text-center mb-10">
          <h2 class="font-heading text-3xl font-extrabold tracking-tight text-text sm:text-4xl">
            Apply to Get <span class="font-display italic text-primary">Listed</span>
          </h2>
          <p class="mt-3 text-text-muted">Fill out the form below and we will be in touch within 3 business days.</p>
        </div>
        <iframe
          src="https://go.kailenflow.com/widget/form/ygDvlbFCuELCAXJldhc8"
          style="width:100%;height:804px;border:none;border-radius:3px"
          id="inline-ygDvlbFCuELCAXJldhc8-getlisted"
          data-layout="{'id':'INLINE'}"
          data-trigger-type="alwaysShow"
          data-trigger-value=""
          data-activation-type="alwaysActivated"
          data-activation-value=""
          data-deactivation-type="neverDeactivate"
          data-deactivation-value=""
          data-form-name="Form 0"
          data-height="804"
          data-layout-iframe-id="inline-ygDvlbFCuELCAXJldhc8-getlisted"
          data-form-id="ygDvlbFCuELCAXJldhc8"
          title="List Your Business on Inside Prosper"
        ></iframe>
        <script is:inline src="https://go.kailenflow.com/js/form_embed.js"></script>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
