---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import BusinessListings from '../components/sections/BusinessListings.astro';
import PopularCategories from '../components/sections/PopularCategories.astro';
import AboutProsper from '../components/sections/AboutProsper.astro';
import EmailCTA from '../components/sections/EmailCTA.astro';
import Footer from '../components/layout/Footer.astro';
import LocalBusinessSchema from '../components/schema/LocalBusinessSchema.astro';
import ItemListSchema from '../components/schema/ItemListSchema.astro';
import { businesses, siteConfig, getBusinessUrl } from '../data/business';

const featuredItems = businesses.slice(0, 6).map((biz) => ({
  name: biz.name,
  url: `${siteConfig.siteUrl}${getBusinessUrl(biz)}`,
}));
---

<BaseLayout
  title="Inside Prosper — Discover The Best Local Businesses in Prosper, Texas"
  description="Prosper, TX local business directory — discover the best restaurants, gyms, shops, and services in Prosper, Texas. Curated and invitation-only."
>
  <LocalBusinessSchema />
  <ItemListSchema
    name="Featured Local Businesses in Prosper, Texas"
    description="Discover the best local businesses in Prosper, TX — handpicked by the community."
    items={featuredItems}
  />
  <Navbar />
  <main>
    <Hero />
    <HowItWorks />
    <BusinessListings />
    <PopularCategories />
    <AboutProsper />
    <EmailCTA />
  </main>
  <Footer />
</BaseLayout>
