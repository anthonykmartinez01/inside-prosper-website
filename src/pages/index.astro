---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import BrandIntro from '../components/sections/BrandIntro.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import BusinessListings from '../components/sections/BusinessListings.astro';
import PopularCategories from '../components/sections/PopularCategories.astro';
import EmailCTA from '../components/sections/EmailCTA.astro';
import HomeFAQ from '../components/sections/HomeFAQ.astro';
import LocationMap from '../components/sections/LocationMap.astro';
import Footer from '../components/layout/Footer.astro';
import LocalBusinessSchema from '../components/schema/LocalBusinessSchema.astro';
import ItemListSchema from '../components/schema/ItemListSchema.astro';
import { publishedBusinesses, siteConfig, getBusinessUrl } from '../data/business';

const featuredItems = publishedBusinesses.slice(0, 6).map((biz) => ({
  name: biz.name,
  url: `${siteConfig.siteUrl}${getBusinessUrl(biz)}`,
}));
---

<BaseLayout
  title="Inside Prosper | Discover the Best Local Businesses in Prosper, TX"
  description="Inside Prosper helps you discover the best local restaurants, shops, and services in Prosper, TX. Curated and invitation-only — no pay-to-play."
>
  <LocalBusinessSchema />
  <ItemListSchema
    name="Featured Local Businesses in Prosper, Texas"
    description="Discover the best local businesses in Prosper, TX — handpicked by the community."
    items={featuredItems}
  />
  <Navbar />
  <main>
    <Hero />
    <BrandIntro />
    <BusinessListings />
    <HowItWorks />
    <PopularCategories />
    <HomeFAQ />
    <LocationMap embedUrl="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3336.374103195625!2d-96.7741919!3d33.2566971!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x864c413a3b41c387%3A0x6960df8b478b8bef!2sInside%20Prosper!5e0!3m2!1sen!2sus!4v1777924774626!5m2!1sen!2sus" />
    <EmailCTA />
  </main>
  <Footer />
</BaseLayout>
