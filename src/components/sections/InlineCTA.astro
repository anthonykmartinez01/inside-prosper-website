---
import { siteConfig } from '../../data/business';

interface Props {
  heading?: string;
  subheading?: string;
}

const {
  heading = 'Need an advertising agency?',
  subheading = 'Explore Businesses. Inside Prosper is ready to help.',
} = Astro.props;
---

<section class="bg-bg py-10">
  <div class="mx-auto max-w-4xl px-6">
    <div class="flex flex-col items-center gap-4 rounded-2xl bg-bg-dark px-6 py-8 text-center sm:flex-row sm:justify-between sm:text-left lg:px-10">
      <div>
        <p class="font-heading text-xl font-extrabold tracking-tight text-white sm:text-2xl">
          {heading}
        </p>
        <p class="mt-1 text-base text-white/60">{subheading}</p>
      </div>
      <a
        href={`tel:${siteConfig.phoneRaw}`}
        class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-full bg-primary px-7 py-3 text-base font-semibold text-white transition-colors hover:bg-primary-dark"
      >
        <svg class="size-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 006.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 011.767-1.052l3.223.716A1.5 1.5 0 0118 15.352V16.5a1.5 1.5 0 01-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 012.43 8.326 13.019 13.019 0 012 5V3.5z" /></svg>
        Call {siteConfig.phone}
      </a>
    </div>
  </div>
</section>
