---
import FAQSchema from '../schema/FAQSchema.astro';

const faqs = [
  {
    question: 'Which businesses do you feature?',
    answer: 'We spotlight all kinds of businesses that serve Prosper, Texas and its surrounding areas. Restaurants, coffee shops, plumbers, roofers, fitness studios, professional services - you name it. <a href="/food-and-fun/" class="text-primary hover:text-primary-dark font-semibold">Check out our current listings</a> for a sample!',
  },
  {
    question: 'How can I get MY business listed?',
    answer: 'Getting listed is easy - jump <a href="/list-your-business/" class="text-primary hover:text-primary-dark font-semibold">here</a> and fill out the application form. Anthony will reach out to schedule a short interview within three business days.',
  },
  {
    question: 'Can I suggest a business even if I don\'t own it?',
    answer: 'Abso-freakin-lutely. Just send us a message and tell us about your favorite business(es) and why you think they should be featured on Inside Prosper.',
  },
  {
    question: 'What makes Inside Prosper different?',
    answer: 'We don\'t do sponsored rankings or any of that "pay-to-play" B.S. We share REAL stories from local business owners so the BEST businesses actually get noticed!',
  },
  {
    question: 'Is it REALLY free? What\'s the catch?',
    answer: 'Yes, really. There are no fees, no ad budgets, and no hidden costs. Listings are earned through quality and reputation, not payment.',
  },
  {
    question: 'What\'s the VERIFIED badge and how do I get it?',
    answer: 'The VERIFIED label means we\'ve personally connected with the business owners to verify their details and confirm their commitment to delivering top-tier products and services to the local community. <a href="/list-your-business/" class="text-primary hover:text-primary-dark font-semibold">Read more about the Verification process here</a>.',
  },
];

const schemaFaqs = faqs.map(f => ({
  question: f.question,
  answer: f.answer.replace(/<[^>]*>/g, ''),
}));
---

<FAQSchema faqs={schemaFaqs} />

<section id="faq" class="bg-bg-alt py-24 lg:py-36">
  <div class="mx-auto max-w-4xl px-6">
    <h2 class="font-heading text-4xl font-black tracking-tight text-text sm:text-5xl text-center mb-12">
      Frequently Asked Questions
    </h2>

    <div class="space-y-3">
      {faqs.map((faq, i) => (
        <details class="group rounded-lg bg-white shadow-sm border border-border" open={i === 0}>
          <summary class="flex cursor-pointer items-center justify-between px-6 py-5 text-lg font-bold text-text transition-colors hover:text-primary">
            {faq.question}
            <svg
              class="size-5 shrink-0 text-text-muted transition-transform duration-200 group-open:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-6 pb-5 text-base leading-relaxed text-text-muted" set:html={faq.answer} />
        </details>
      ))}
    </div>
  </div>
</section>
