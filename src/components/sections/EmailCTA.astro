---
---

<section class="relative overflow-hidden bg-bg-dark py-28 lg:py-36">

  <div class="relative z-10 mx-auto max-w-2xl px-6 text-center">
    <div class="reveal">
      <span class="mb-4 inline-block text-sm font-semibold uppercase tracking-wider text-primary">
        Support Local
      </span>
      <h2 class="font-heading text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Discover Prosper's Best <span class="font-display italic text-primary">Local Businesses</span>
      </h2>
      <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-[#F5F5F5]/60">
        Browse trusted, locally owned businesses or get your own business featured on Inside Prosper.
      </p>

      <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href="/food-and-fun/"
          class="group inline-flex items-center gap-2 rounded-full bg-primary px-8 py-3.5 text-sm font-semibold text-white transition-all duration-200 hover:bg-primary-dark"
        >
          Explore Businesses
          <span class="flex size-8 items-center justify-center rounded-full bg-white/20">
            <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </span>
        </a>
        <a
          href="/list-your-business/"
          class="inline-flex items-center gap-2 rounded-full border border-white/20 px-8 py-3.5 text-sm font-semibold text-white transition-all duration-200 hover:border-primary hover:text-primary"
        >
          List Your Business
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>
