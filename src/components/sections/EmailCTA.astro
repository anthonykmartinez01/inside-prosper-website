---
---

<section id="get-listed" class="bg-bg-dark py-20 lg:py-28">
  <div class="mx-auto max-w-2xl px-6 text-center">
    <div class="reveal">
      <span class="mb-4 inline-block text-sm font-semibold uppercase tracking-wider text-primary">
        Stay Connected
      </span>
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">
        Discover More Prosper <span class="italic text-primary">Businesses</span>
      </h2>
      <p class="mx-auto mt-4 max-w-lg text-base text-white/70">
        Sign up to get the latest local business news, deals, and giveaways.
      </p>

      <form class="mx-auto mt-10 flex max-w-md flex-col gap-3 sm:flex-row" data-email-form>
        <input
          type="email"
          placeholder="Email Address"
          required
          class="flex-1 rounded-full border border-white/20 bg-white/10 px-5 py-3.5 text-sm text-white placeholder:text-white/50 focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none backdrop-blur-sm"
        />
        <button
          type="submit"
          class="whitespace-nowrap rounded-full bg-primary px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-primary-dark"
        >
          Get News & Win Prizes 🎉
        </button>
      </form>
    </div>
  </div>
</section>
