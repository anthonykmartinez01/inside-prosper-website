---
---

<section id="get-listed" class="relative overflow-hidden bg-bg-dark py-28 lg:py-36">
  <!-- Faint background decoration -->
  <div class="pointer-events-none absolute inset-0 flex items-center justify-center overflow-hidden">
    <span class="select-none font-hero text-[15vw] font-bold uppercase leading-none text-white/[0.03]">
      PROSPER
    </span>
  </div>

  <div class="relative z-10 mx-auto max-w-2xl px-6 text-center">
    <div class="reveal">
      <span class="mb-4 inline-block text-sm font-semibold uppercase tracking-wider text-primary">
        Stay Connected
      </span>
      <h2 class="font-heading text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Discover More Prosper <span class="font-display italic text-primary">Businesses</span>
      </h2>
      <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-[#F5F5F5]/60">
        Sign up to get the latest local business news, deals, and giveaways.
      </p>

      <form class="mx-auto mt-10 flex max-w-md flex-col gap-3 sm:flex-row" data-email-form>
        <input
          type="email"
          placeholder="Email Address"
          required
          class="flex-1 rounded-full border border-white/15 bg-white/5 px-5 py-3.5 text-sm text-white placeholder:text-white/40 focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none backdrop-blur-sm"
        />
        <button
          type="submit"
          class="group whitespace-nowrap rounded-full bg-primary pl-6 pr-2 py-2 text-sm font-semibold text-white transition-all duration-200 hover:bg-primary-dark inline-flex items-center gap-2"
        >
          <span>Get News & Win Prizes</span>
          <span class="flex size-8 items-center justify-center rounded-full bg-white/20">
            <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </span>
        </button>
      </form>
    </div>
  </div>
</section>
