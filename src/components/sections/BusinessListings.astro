---
import BusinessCard from '../ui/BusinessCard.astro';
import { businesses, categories } from '../../data/business';

// Featured businesses: The Red Roofer first, then fill with others
const featuredSlugs = ['the-red-roofer', '1418-coffee', 'salsa-tex-mex', 'premas-kitchen', 'sake-sushi-hibachi', 'crossfit-prosper'];
const recentBusinesses = featuredSlugs
  .map(slug => businesses.find(b => b.slug === slug))
  .filter(Boolean) as typeof businesses;
---

<section id="businesses" class="bg-bg py-24 lg:py-36">
  <div class="mx-auto max-w-7xl px-6">
    <!-- Section header -->
    <div class="reveal mb-16 text-center">
      <span class="mb-4 inline-block text-sm font-semibold uppercase tracking-wider text-primary">
        Local Favorites
      </span>
      <h2 class="font-heading text-4xl font-extrabold tracking-tight text-text sm:text-5xl">
        Featured Prosper, TX Local <span class="font-display italic text-primary">Businesses</span>
      </h2>
      <p class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-text-muted">
        Trusted local businesses handpicked by the Prosper community.
      </p>
    </div>

    <!-- Business cards grid -->
    <div class="reveal-stagger grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {recentBusinesses.map((biz) => {
        const cat = categories.find(c => c.slug === biz.category);
        return (
          <div class="reveal">
            <BusinessCard
              name={biz.name}
              description={biz.shortDescription}
              image={biz.image}
              slug={biz.slug}
              category={cat?.name}
              categoryUrlPath={cat?.urlPath}
              imagePosition={biz.imagePosition}
            />
          </div>
        );
      })}
    </div>
  </div>
</section>
