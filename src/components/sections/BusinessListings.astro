---
import BusinessCard from '../ui/BusinessCard.astro';
import { getRecentBusinesses } from '../../data/business';

const recentBusinesses = getRecentBusinesses(6);
---

<section id="businesses" class="bg-bg py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-6">
    <!-- Section header -->
    <div class="reveal mb-14 text-center">
      <span class="mb-4 inline-block text-sm font-semibold uppercase tracking-wider text-primary">
        Local Favorites
      </span>
      <h2 class="font-display text-3xl font-bold text-text sm:text-4xl">
        Recently Added Local <span class="italic text-primary">Businesses</span>
      </h2>
      <p class="mx-auto mt-4 max-w-lg text-base text-text-muted">
        Check out these hometown favorites!
      </p>
    </div>

    <!-- Business cards grid -->
    <div class="reveal-stagger grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {recentBusinesses.map((biz) => (
        <div class="reveal">
          <BusinessCard
            name={biz.name}
            description={biz.shortDescription}
            image={biz.image}
            slug={biz.slug}
          />
        </div>
      ))}
    </div>
  </div>
</section>
