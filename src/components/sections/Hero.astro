---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/hero-prosper.jpg';
---

<section class="relative min-h-[45vh] lg:min-h-[70vh] overflow-hidden bg-bg-dark" data-hero-section>
  <!-- Layer 1: Full background image (sky + scene) — LCP element -->
  <div class="absolute inset-0" data-hero-bg>
    <Image
      src={heroImage}
      alt="Sunset over Prosper, Texas — a small-town main street with American flags and grain silos"
      class="size-full object-cover"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      width={1264}
      height={842}
      quality={100}
      format="webp"
    />
  </div>

  <!-- Layer 2: Spacer (giant text removed) -->
  <div class="pointer-events-none absolute inset-0" data-hero-text></div>

  <!-- Layer 3: Foreground cutout — same image with CSS mask revealing only bottom portion.
       Decorative duplicate of Layer 1 — same file (deduped by browser cache),
       just decoded and painted with the gradient mask. Marked low priority + async
       decode so it doesn't compete with the LCP image. -->
  <div class="absolute inset-0 hero-foreground-mask" data-hero-fg>
    <Image
      src={heroImage}
      alt=""
      aria-hidden="true"
      class="size-full object-cover"
      loading="eager"
      fetchpriority="low"
      decoding="async"
      width={1264}
      height={842}
      quality={100}
      format="webp"
    />
  </div>

  <!-- Layer 4: Gradient overlay — lighter in middle so PROSPER text shows clearly.
       JS controls opacity (0.6 → 1.0) for scroll-based darkening. -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#0D0D0D]/80 via-[#0D0D0D]/15 to-[#0D0D0D]/95" data-hero-overlay></div>

  <!-- Layer 5: Foreground content -->
  <div class="relative z-20 mx-auto max-w-7xl px-6 pt-20 pb-8 lg:pt-40 lg:pb-28" data-hero-content>
    <div class="max-w-2xl">
      <!-- Badge — slides down from above -->
      <div data-hero-el="badge" class="hero-animate hero-animate-slide-down mb-6 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-medium text-white/90 backdrop-blur-sm border border-white/10">
        <svg class="size-4 text-primary" fill="currentColor" viewBox="0 0 20 20"><path d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" /></svg>
        Welcome to Inside Prosper
      </div>

      <!-- Heading — NO entrance animation (LCP element must render immediately) -->
      <h1 data-hero-el="heading" class="font-heading text-5xl font-extrabold leading-[1.05] tracking-tight text-white sm:text-6xl lg:text-7xl xl:text-8xl">
        Discover the Best Local
        <span class="font-display italic text-primary">Businesses</span>
        in Prosper, Texas
      </h1>

      <!-- Subtitle — fade only -->
      <p data-hero-el="subtitle" class="hero-animate hero-animate-fade hero-animate-delay-2 mt-6 max-w-lg text-base leading-relaxed text-[#F5F5F5]/70 sm:text-lg">
        17+ handpicked local businesses — curated for Prosper residents who support their neighbors.
      </p>

      <!-- CTA buttons — slide up -->
      <div data-hero-el="cta" class="hero-animate hero-animate-delay-3 mt-10 flex flex-wrap items-center gap-4">
        <a
          href="#businesses"
          class="group inline-flex items-center gap-3 rounded-full bg-primary pl-7 pr-2 py-2 font-semibold text-white transition-all duration-200 hover:bg-primary-dark"
        >
          <span class="text-sm sm:text-base">Explore Businesses</span>
          <span class="flex size-10 items-center justify-center rounded-full bg-white/20 transition-transform duration-200 group-hover:translate-x-0.5">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </span>
        </a>
        <a
          href="/list-your-business/"
          class="inline-flex items-center gap-2 rounded-full border border-white/25 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition-all duration-200 hover:bg-white/10 sm:text-base"
        >
          List Your Business
        </a>
      </div>

      <!-- Social proof avatar stack — fade only -->
      <div data-hero-el="social" class="hero-animate hero-animate-fade hero-animate-delay-4 mt-12 flex items-center gap-4">
        <div class="flex -space-x-3">
          <div class="size-10 rounded-full border-2 border-white/80 bg-gradient-to-br from-primary to-primary-dark"></div>
          <div class="size-10 rounded-full border-2 border-white/80 bg-gradient-to-br from-amber-400 to-orange-500"></div>
          <div class="size-10 rounded-full border-2 border-white/80 bg-gradient-to-br from-rose-400 to-pink-500"></div>
          <div class="size-10 rounded-full border-2 border-white/80 bg-gradient-to-br from-violet-400 to-indigo-500"></div>
        </div>
        <p class="text-sm text-[#F5F5F5]/60">
          Join neighbors discovering local gems in Prosper
        </p>
      </div>
    </div>
  </div>

</section>
