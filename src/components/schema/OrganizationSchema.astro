---
import { siteConfig } from '../../data/business';
---

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": siteConfig.name,
  "url": siteConfig.siteUrl,
  "email": siteConfig.email,
  "description": siteConfig.description,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.street,
    "addressLocality": siteConfig.city,
    "addressRegion": siteConfig.state,
    "postalCode": siteConfig.zip,
    "addressCountry": "US"
  },
  "telephone": siteConfig.phone,
  "areaServed": [
    { "@type": "City", "name": "Prosper" },
    { "@type": "City", "name": "Celina" },
    { "@type": "City", "name": "Frisco" },
    { "@type": "City", "name": "McKinney" },
    { "@type": "City", "name": "Little Elm" },
    { "@type": "City", "name": "Aubrey" }
  ],
  "memberOf": {
    "@type": "Organization",
    "name": siteConfig.chamber.name,
    "url": siteConfig.chamber.url
  },
  "sameAs": [
    "https://www.facebook.com/people/InsideProsper/61574519054783/",
    siteConfig.chamber.listingUrl
  ]
})} />
