---
import { siteConfig } from '../../data/business';
---

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": siteConfig.name,
  "description": siteConfig.description,
  "url": siteConfig.siteUrl,
  "email": siteConfig.email,
  "telephone": siteConfig.phone,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.street,
    "addressLocality": siteConfig.city,
    "addressRegion": siteConfig.state,
    "postalCode": siteConfig.zip,
    "addressCountry": "US"
  },
  "areaServed": [
    { "@type": "City", "name": "Prosper" },
    { "@type": "City", "name": "Celina" },
    { "@type": "City", "name": "Frisco" },
    { "@type": "City", "name": "McKinney" },
    { "@type": "City", "name": "Little Elm" },
    { "@type": "City", "name": "Aubrey" }
  ],
  "image": `${siteConfig.siteUrl}/images/hero-prosper.jpg`,
  "priceRange": "Free",
  "knowsAbout": [
    "Local businesses in Prosper Texas",
    "Prosper TX restaurants",
    "Prosper TX services",
    "Prosper Texas directory"
  ],
  "sameAs": [
    "https://www.facebook.com/REPLACE_WITH_FACEBOOK_URL/people/InsideProsper/61574519054783/",
    "https://www.prosperchamber.com/REPLACE_WITH_CHAMBER_LISTING_URL/list/member/inside-prosper-7757"
  ]
})} />
