---
interface Props {
  name: string;
  description: string;
  image: string;
  slug: string;
}

const { name, description, image, slug } = Astro.props;
---

<div class="card-hover group overflow-hidden rounded-2xl border border-border-light bg-bg-card">
  <div class="aspect-[4/3] overflow-hidden">
    <img
      src={image}
      alt={name}
      width="400"
      height="300"
      loading="lazy"
      class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>
  <div class="p-5">
    <h3 class="font-display text-lg font-bold text-text">{name}</h3>
    <p class="mt-2 text-sm leading-relaxed text-text-muted line-clamp-2">{description}</p>
    <a
      href={`#${slug}`}
      class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary transition-colors hover:text-primary-dark"
    >
      View Profile
      <svg class="size-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
    </a>
  </div>
</div>
