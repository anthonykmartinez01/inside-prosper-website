---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  description: string;
  image: string;
  slug: string;
  category?: string;
  categoryUrlPath?: string;
  imagePosition?: string;
}

const { name, description, image, slug, category, categoryUrlPath, imagePosition } = Astro.props;
const imgStyle = imagePosition ? `object-position: ${imagePosition}` : '';

// Build the business URL: /category-url-path/slug/ if we have categoryUrlPath, else fallback
const href = categoryUrlPath ? `/${categoryUrlPath}/${slug}/` : `/business/${slug}/`;

// Resolve local images from src/assets for Astro optimization
const localImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{png,jpg,jpeg,webp}', { eager: true });
const isLocal = image.startsWith('/images/');
const filename = isLocal ? image.replace('/images/', '') : '';
const resolvedImage = isLocal ? localImages[`/src/assets/images/${filename}`]?.default : null;
---

<div class="card-hover group overflow-hidden rounded-2xl bg-bg-card shadow-sm">
  <div class="relative aspect-[4/3] overflow-hidden">
    {resolvedImage ? (
      <Image
        src={resolvedImage}
        alt={`${name} — local business in Prosper, Texas`}
        width={400}
        height={300}
        loading="lazy"
        format="webp"
        quality={85}
        class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
        style={imgStyle}
      />
    ) : (
      <img
        src={image}
        alt={`${name} — local business in Prosper, Texas`}
        width="400"
        height="300"
        loading="lazy"
        class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
        style={imgStyle}
      />
    )}
    {category && (
      <span class="absolute top-3 left-3 rounded-full bg-white/90 backdrop-blur-sm px-3 py-1 text-xs font-semibold text-text shadow-sm">
        {category}
      </span>
    )}
  </div>
  <div class="p-5">
    <h3 class="font-heading text-lg font-bold text-text">{name}</h3>
    <p class="mt-2 text-sm leading-relaxed text-text-muted line-clamp-2">{description}</p>
    <div class="mt-4 flex items-center justify-between">
      <a
        href={href}
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary transition-colors hover:text-primary-dark"
      >
        View Profile
        <svg class="size-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
      <span class="flex size-8 items-center justify-center rounded-full bg-primary/10 text-primary transition-all duration-200 group-hover:bg-primary group-hover:text-white">
        <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </span>
    </div>
  </div>
</div>
