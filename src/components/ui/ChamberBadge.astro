---
import { siteConfig } from '../../data/business';

interface Props {
  /** 'dark' for dark backgrounds (hero, footer). 'light' for light sections. */
  tone?: 'dark' | 'light';
  /** 'sm' compact inline badge. 'md' larger card-style badge for feature placements. */
  size?: 'sm' | 'md';
}

const { tone = 'dark', size = 'sm' } = Astro.props;

const toneClasses = {
  dark: 'border-white/15 bg-white/5 backdrop-blur-sm hover:border-primary/50 hover:bg-white/10',
  light: 'border-border bg-bg-card shadow-sm hover:border-primary/50 hover:shadow-md',
}[tone];

const nameToneClasses = {
  dark: 'text-white',
  light: 'text-text',
}[tone];

const arrowToneClasses = {
  dark: 'text-white/40',
  light: 'text-text-muted',
}[tone];

const paddingClasses = { sm: 'gap-3 px-4 py-3', md: 'gap-4 px-6 py-4' }[size];
const sealClasses = { sm: 'size-10', md: 'size-12' }[size];
const nameClasses = { sm: 'text-sm', md: 'text-base' }[size];
---

<a
  href={siteConfig.chamber.listingUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${siteConfig.name} is a proud member of the ${siteConfig.chamber.name} — view our member listing (opens in a new tab)`}
  class:list={[
    'group inline-flex items-center rounded-2xl border transition-all duration-200',
    paddingClasses,
    toneClasses,
  ]}
>
  <!-- Member seal: 8-point seal shape with a verification check -->
  <svg
    class:list={['shrink-0 text-primary', sealClasses]}
    viewBox="0 0 40 40"
    fill="none"
    aria-hidden="true"
  >
    <rect x="7" y="7" width="26" height="26" rx="5" fill="currentColor" />
    <rect x="7" y="7" width="26" height="26" rx="5" fill="currentColor" transform="rotate(45 20 20)" />
    <path
      d="M15 20.5l3.5 3.5 6.5-7"
      stroke="#0D0D0D"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>

  <span class="flex flex-col">
    <span class="text-xs font-bold uppercase tracking-widest text-primary">Proud Member</span>
    <span class:list={['font-heading font-bold leading-snug', nameClasses, nameToneClasses]}>
      {siteConfig.chamber.name}
    </span>
  </span>

  <svg
    class:list={[
      'ml-1 size-4 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5',
      arrowToneClasses,
    ]}
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
  </svg>
</a>
