---
import { siteConfig, categories, getCategoryUrl } from '../../data/business';
---

<footer class="border-t border-white/10 bg-bg-dark py-16">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand + NAP -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2.5 text-xl font-bold text-white">
          <span class="text-primary text-2xl">&#9826;</span>
          <span class="font-heading">{siteConfig.name}</span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-white/50">
          Discover the best local businesses in Prosper, Texas. Curated by the community, for the community.
        </p>
        <address class="mt-4 flex flex-col gap-1.5 text-sm not-italic text-white/50">
          <span>{siteConfig.city}, {siteConfig.state} {siteConfig.zip}</span>
          <a href={`tel:${siteConfig.phoneRaw}`} class="transition-colors hover:text-primary">{siteConfig.phone}</a>
          <a href={`mailto:${siteConfig.email}`} class="transition-colors hover:text-primary">{siteConfig.email}</a>
        </address>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white/70">Categories</h3>
        <nav class="mt-4 flex flex-col gap-2.5">
          {categories.map((cat) => (
            <a href={getCategoryUrl(cat)} class="text-sm text-white/50 transition-colors hover:text-primary">
              {cat.name}
            </a>
          ))}
        </nav>
      </div>

      <!-- Pages -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white/70">Explore</h3>
        <nav class="mt-4 flex flex-col gap-2.5">
          <a href="/about/" class="text-sm text-white/50 transition-colors hover:text-primary">About</a>
          <a href="/prosper-guide/" class="text-sm text-white/50 transition-colors hover:text-primary">Prosper Guide</a>
          <a href="/get-listed/" class="text-sm text-white/50 transition-colors hover:text-primary">Get Listed</a>
          <a href="/blog/" class="text-sm text-white/50 transition-colors hover:text-primary">Blog</a>
        </nav>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white/70">Legal</h3>
        <nav class="mt-4 flex flex-col gap-2.5">
          <a href="/privacy/" class="text-sm text-white/50 transition-colors hover:text-primary">Privacy Policy</a>
          <a href="/terms/" class="text-sm text-white/50 transition-colors hover:text-primary">Terms of Service</a>
        </nav>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 border-t border-white/10 pt-8 text-center">
      <p class="text-sm text-white/40">
        &copy; 2026 {siteConfig.name}. All Rights Reserved.
      </p>
    </div>
  </div>
</footer>
