---
import '../../styles/global.css';
import { siteConfig } from '../../data/business';
import OrganizationSchema from '../schema/OrganizationSchema.astro';
import WebSiteSchema from '../schema/WebSiteSchema.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/images/hero-prosper.jpg' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content={siteConfig.name} />
    <meta name="theme-color" content="#F28C38" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content="Inside Prosper — Discover the best local businesses in Prosper, Texas" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts — only preload the two critical weights (body + heading) -->
    <link rel="preload" href="/fonts/plus-jakarta-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plus-jakarta-sans-800.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <OrganizationSchema />
    <WebSiteSchema />
    <slot />

    <script>
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ── Section reveal observer (works for all motion preferences) ──
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              // Free GPU memory after animation completes
              setTimeout(() => {
                (entry.target as HTMLElement).style.willChange = 'auto';
              }, 1000);
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );

      document.querySelectorAll('.reveal').forEach((el) => {
        if (!prefersReducedMotion) {
          (el as HTMLElement).style.willChange = 'transform, opacity';
        }
        revealObserver.observe(el);
      });

      // ── Hero scroll animations (skip entirely for reduced motion) ──
      if (!prefersReducedMotion) {
        const heroBg = document.querySelector('[data-hero-bg]') as HTMLElement | null;
        const heroFg = document.querySelector('[data-hero-fg]') as HTMLElement | null;
        const heroText = document.querySelector('[data-hero-text]') as HTMLElement | null;
        const heroOverlay = document.querySelector('[data-hero-overlay]') as HTMLElement | null;
        const heroSection = document.querySelector('[data-hero-section]') as HTMLElement | null;

        // Individual hero content elements for staggered scroll animation
        const heroEls = [
          { el: document.querySelector('[data-hero-el="badge"]') as HTMLElement | null,   offset: 0.00, drift: -30, scale: 0.96 },
          { el: document.querySelector('[data-hero-el="heading"]') as HTMLElement | null,  offset: 0.04, drift: -50, scale: 0.97 },
          { el: document.querySelector('[data-hero-el="subtitle"]') as HTMLElement | null, offset: 0.08, drift: -35, scale: 0.98 },
          { el: document.querySelector('[data-hero-el="cta"]') as HTMLElement | null,      offset: 0.12, drift: -25, scale: 0.98 },
          { el: document.querySelector('[data-hero-el="social"]') as HTMLElement | null,   offset: 0.16, drift: -20, scale: 1.00 },
        ];

        const heroHeight = heroSection?.offsetHeight || window.innerHeight;

        // After entrance animations complete (~2.2s), strip animation property
        // so JS scroll animations can take over inline styles.
        // H1 heading has no animation (LCP element renders immediately).
        const ENTRANCE_DURATION = 2200;
        setTimeout(() => {
          heroEls.forEach(({ el }) => {
            if (!el) return;
            const computed = getComputedStyle(el);
            el.style.opacity = computed.opacity;
            el.style.transform = computed.transform === 'none' ? '' : computed.transform;
            el.style.animation = 'none';
          });
        }, ENTRANCE_DURATION);

        // Promote animated layers to GPU
        [heroBg, heroFg, heroText, heroOverlay].forEach(el => {
          if (el) el.style.willChange = 'transform, opacity';
        });
        heroEls.forEach(({ el }) => {
          if (el) el.style.willChange = 'transform, opacity, filter';
        });

        // Smooth easing curve — decelerates for a buttery feel
        function easeOutQuart(t: number): number {
          return 1 - Math.pow(1 - t, 4);
        }

        // rAF-throttled scroll handler — one calculation per frame max
        let ticking = false;

        function updateHeroAnimations() {
          const y = window.scrollY;
          const progress = Math.min(Math.max(y / heroHeight, 0), 1);

          // ── Background image: parallax + cinematic zoom settle ──
          if (heroBg) {
            const imgY = y * 0.25;
            const imgScale = 1.05 - progress * 0.05;
            const imgTransform = `translateY(${imgY}px) scale(${imgScale})`;
            heroBg.style.transform = imgTransform;
            if (heroFg) heroFg.style.transform = imgTransform;
          }

          // ── Overlay darken on scroll ──
          if (heroOverlay) {
            heroOverlay.style.opacity = String(0.6 + progress * 0.4);
          }

          // ── Staggered content: each element fades/drifts independently ──
          // Each element has its own scroll "window" defined by offset.
          // Badge goes first, social proof goes last — cascading dissolve.
          for (const { el, offset, drift, scale } of heroEls) {
            if (!el) continue;

            // Each element animates over ~30% of scroll travel, starting at its offset
            const fadeSpeed = 3.3; // completes fade in ~30% of hero scroll
            const localProgress = Math.min(Math.max((progress - offset) * fadeSpeed, 0), 1);
            const eased = easeOutQuart(localProgress);

            const opacity = 1 - eased;
            const translateY = drift * eased;
            const scaleVal = 1 + (scale - 1) * eased;
            const blur = eased * 4; // subtle blur at end of fade

            el.style.opacity = String(Math.max(opacity, 0));
            el.style.transform = `translateY(${translateY}px) scale(${scaleVal})`;
            el.style.filter = blur > 0.1 ? `blur(${blur}px)` : 'none';
          }

          ticking = false;
        }

        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(updateHeroAnimations);
            ticking = true;
          }
        }, { passive: true });

        // ── will-change cleanup: free GPU when hero leaves viewport ──
        const heroGpuObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const willChange = entry.isIntersecting ? 'transform, opacity, filter' : 'auto';
              [heroBg, heroFg, heroText, heroOverlay].forEach(el => {
                if (el) el.style.willChange = entry.isIntersecting ? 'transform, opacity' : 'auto';
              });
              heroEls.forEach(({ el }) => {
                if (el) el.style.willChange = willChange;
              });
            });
          },
          { threshold: 0 }
        );
        if (heroSection) heroGpuObserver.observe(heroSection);

        // Set initial state immediately (don't wait for first scroll)
        updateHeroAnimations();
      }
    </script>
  </body>
</html>
